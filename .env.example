# Copy to .env for local development. Never commit the real .env file.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
PUBLIC_ORIGIN=http://localhost:3000

# German raw-milk monthly prices are checked once per week via the
# European Commission Agri-food API. No key or URL configuration is needed.

# Optional Web Push. Generate one stable key pair with `pnpm vapid:generate`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:it@example.org
