{
  "name": "bvl-sales-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.15.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "vapid:generate": "node scripts/generate-vapid.mjs",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "sharp": "0.35.4"
  }
}
